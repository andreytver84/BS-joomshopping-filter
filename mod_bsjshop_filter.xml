<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_BSJSHOP_FILTER</name>
    <author>Andrey Uvikov</author>
    <authorEmail>order@bestsite-studio.ru</authorEmail>
    <authorUrl>https://bestsite-tver.ru</authorUrl>
    <creationDate>2026</creationDate>
    <copyright>Copyright (C) 2026 Andrey Uvikov</copyright>
    <license>GNU General Public License version 2 or later</license>
    <version>1.5.0</version>
    <description><![CDATA[
        <div style="background:#f4f7f9;padding:20px;border-left:5px solid #004E82;border-radius:4px;font-family:sans-serif;margin-bottom:20px;">
            <h2 style="margin-top:0;color:#004E82;">Товары JoomShopping и фильтры</h2>
            <p>Список товаров JoomShopping 5 для Joomla 4, 5 и 6. Категории, цену и площадь можно выключить. Можно ограничить вывод списком ID товаров.</p>
            <h3 style="color:#333;border-bottom:1px solid #ccc;padding-bottom:5px;margin-top:20px;">Настройка</h3>
            <ol>
                <li>Опубликуйте модуль на странице каталога. Заголовок задаётся полем «Заголовок каталога».</li>
                <li>Укажите ID родительской категории или список ID категорий для вкладок. Пустые поля — корневые опубликованные категории.</li>
                <li>Введите ID характеристики площади (JoomShopping → Характеристики). Для диапазона лучше текстовое числовое поле.</li>
                <li>Категории, цену и площадь можно выключить по отдельности. Без категорий остаётся сетка товаров.</li>
                <li>ID товаров через запятую ограничивают список. Пустое поле — все товары выбранных категорий или весь каталог, если категории выключены.</li>
                <li>Характеристики карточки (площадь, размеры, этажи) задаются списком: ID, префикс и постфикс. В фильтре они не участвуют.</li>
                <li>При необходимости включите префикс «от» перед ценой на карточке.</li>
            </ol>
            <p style="background:#fff;padding:10px;border:1px dashed #999;margin-top:15px;">
                Нужен установленный и опубликованный компонент <b>JoomShopping 5</b>. Список подгружается через AJAX без перезагрузки страницы.
            </p>
        </div>
    ]]></description>
    <namespace path="src">Bestsite\Module\BsjshopFilter</namespace>
    <files>
        <filename module="mod_bsjshop_filter">mod_bsjshop_filter.php</filename>
        <filename>helper.php</filename>
        <folder>src</folder>
        <folder>services</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
        <folder>assets</folder>
    </files>
    <languages>
        <language tag="ru-RU">language/ru-RU/ru-RU.mod_bsjshop_filter.ini</language>
        <language tag="ru-RU">language/ru-RU/ru-RU.mod_bsjshop_filter.sys.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_bsjshop_filter.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.mod_bsjshop_filter.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic" label="MOD_BSJSHOP_FILTER_FIELDSET_BASIC">
                <field name="show_title" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_BSJSHOP_FILTER_FIELD_SHOW_TITLE_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_SHOW_TITLE_DESC" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="catalog_title" type="text" label="MOD_BSJSHOP_FILTER_FIELD_TITLE_LABEL" default="MOD_BSJSHOP_FILTER_DEFAULT_TITLE" translate_default="true" showon="show_title:1" />

                <field name="show_categories" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_BSJSHOP_FILTER_FIELD_SHOW_CATEGORIES_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_SHOW_CATEGORIES_DESC" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="parent_category_id" type="number" label="MOD_BSJSHOP_FILTER_FIELD_PARENT_CAT_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_PARENT_CAT_DESC" default="0" min="0" step="1" showon="show_categories:1" />

                <field name="category_ids" type="text" label="MOD_BSJSHOP_FILTER_FIELD_CAT_IDS_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_CAT_IDS_DESC" default="" showon="show_categories:1" />

                <field name="show_all_tab" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_BSJSHOP_FILTER_FIELD_SHOW_ALL_LABEL" default="1" showon="show_categories:1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="product_ids" type="text" label="MOD_BSJSHOP_FILTER_FIELD_PRODUCT_IDS_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_PRODUCT_IDS_DESC" default="" />

                <field name="show_price" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_BSJSHOP_FILTER_FIELD_SHOW_PRICE_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_SHOW_PRICE_DESC" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="show_area" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_BSJSHOP_FILTER_FIELD_SHOW_AREA_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_SHOW_AREA_DESC" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="extra_field_area_id" type="number" label="MOD_BSJSHOP_FILTER_FIELD_AREA_ID_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_AREA_ID_DESC" default="0" min="0" step="1" showon="show_area:1" />

                <field name="extra_field_area_unit" type="text" label="MOD_BSJSHOP_FILTER_FIELD_AREA_UNIT_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_AREA_UNIT_DESC" default="м²" showon="show_area:1" />

                <field name="apply_class" type="text" label="MOD_BSJSHOP_FILTER_FIELD_APPLY_CLASS_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_APPLY_CLASS_DESC" default="" showon="show_price:1[OR]show_area:1" />

                <field name="reset_class" type="text" label="MOD_BSJSHOP_FILTER_FIELD_RESET_CLASS_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_RESET_CLASS_DESC" default="" showon="show_price:1[OR]show_area:1" />

                <field name="card_fields" type="subform" label="MOD_BSJSHOP_FILTER_FIELD_CARD_FIELDS_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_CARD_FIELDS_DESC" multiple="true" layout="joomla.form.field.subform.repeatable-table">
                    <form>
                        <field name="field_id" type="number" label="MOD_BSJSHOP_FILTER_FIELD_CARD_FIELD_ID_LABEL" min="1" step="1" />
                        <field name="prefix" type="text" label="MOD_BSJSHOP_FILTER_FIELD_CARD_PREFIX_LABEL" />
                        <field name="postfix" type="text" label="MOD_BSJSHOP_FILTER_FIELD_CARD_POSTFIX_LABEL" />
                    </form>
                </field>

                <field name="limit" type="number" label="MOD_BSJSHOP_FILTER_FIELD_LIMIT_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_LIMIT_DESC" default="6" min="1" max="48" step="1" />

                <field name="cols_lg" type="list" label="MOD_BSJSHOP_FILTER_FIELD_COLS_LG_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_COLS_LG_DESC" default="3">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                </field>

                <field name="cols_md" type="list" label="MOD_BSJSHOP_FILTER_FIELD_COLS_MD_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_COLS_MD_DESC" default="2">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </field>

                <field name="cols_sm" type="list" label="MOD_BSJSHOP_FILTER_FIELD_COLS_SM_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_COLS_SM_DESC" default="1">
                    <option value="1">1</option>
                    <option value="2">2</option>
                </field>

                <field name="show_more" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_BSJSHOP_FILTER_FIELD_SHOW_MORE_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_SHOW_MORE_DESC" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field name="more_text" type="text" label="MOD_BSJSHOP_FILTER_FIELD_MORE_TEXT_LABEL" default="MOD_BSJSHOP_FILTER_MORE" translate_default="true" showon="show_more:1" />

                <field name="more_class" type="text" label="MOD_BSJSHOP_FILTER_FIELD_MORE_CLASS_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_MORE_CLASS_DESC" default="" showon="show_more:1" />

                <field name="ordering" type="list" label="MOD_BSJSHOP_FILTER_FIELD_ORDERING_LABEL" default="name">
                    <option value="name">MOD_BSJSHOP_FILTER_OPTION_ORDER_NAME</option>
                    <option value="price">MOD_BSJSHOP_FILTER_OPTION_ORDER_PRICE</option>
                    <option value="date">MOD_BSJSHOP_FILTER_OPTION_ORDER_DATE</option>
                    <option value="id">MOD_BSJSHOP_FILTER_OPTION_ORDER_ID</option>
                </field>

                <field name="ordering_dir" type="list" label="MOD_BSJSHOP_FILTER_FIELD_ORDER_DIR_LABEL" default="ASC">
                    <option value="ASC">MOD_BSJSHOP_FILTER_OPTION_ASC</option>
                    <option value="DESC">MOD_BSJSHOP_FILTER_OPTION_DESC</option>
                </field>

                <field name="price_decimals" type="number" label="MOD_BSJSHOP_FILTER_FIELD_DECIMALS_LABEL" default="0" min="0" max="2" step="1" />

                <field name="price_from_prefix" type="radio" layout="joomla.form.field.radio.switcher" label="MOD_BSJSHOP_FILTER_FIELD_PRICE_PREFIX_LABEL" description="MOD_BSJSHOP_FILTER_FIELD_PRICE_PREFIX_DESC" default="1">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>

            <fieldset name="advanced">
                <field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" />
                <field name="moduleclass_sfx" type="text" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" />
                <field name="cache" type="list" label="COM_MODULES_FIELD_CACHING_LABEL" default="0">
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>
                <field name="cache_time" type="number" label="COM_MODULES_FIELD_CACHE_TIME_LABEL" default="0" />
            </fieldset>
        </fields>
    </config>
    <updateservers>
        <server type="extension" priority="1" name="BS JoomShopping Filter Update Server">https://raw.githubusercontent.com/andreytver84/BS-joomshopping-filter/main/update.xml</server>
    </updateservers>
</extension>
